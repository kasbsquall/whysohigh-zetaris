{
  "name": "whysohigh",
  "version": "0.1.0",
  "private": true,
  "description": "Snap your electricity bill. Why So High tells you why it went up and what you can do about it this month.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "explain": "tsx cli/explain.ts",
    "doctor": "tsx cli/doctor.ts",
    "db:up": "docker compose --env-file .env -f infra/household-db/docker-compose.yml up -d",
    "setup:sources": "tsx cli/setup-sources.ts",
    "zsql": "tsx cli/zsql.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "conformance:hmem": "tsx engines/hmem/conformance/runner.ts",
    "conformance:world-model": "tsx engines/world-model/conformance/runner.ts",
    "remember": "tsx cli/remember.ts",
    "demo": "tsx cli/demo.ts",
    "eval:generate": "tsx eval/generate.ts",
    "eval": "tsx eval/run.ts",
    "eval:billreader": "tsx eval/billreader.ts",
    "eval:explainer": "tsx eval/explainer.ts",
    "serve": "tsx server/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:static": "tsx scripts/build-static.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.0"
  }
}
